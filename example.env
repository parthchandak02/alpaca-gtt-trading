# Alpaca GTT Order Tracker - Environment Configuration
# Copy this file to .env and fill in your values

# ========== TRADING MODE ==========
# Set to 'true' for paper trading, 'false' for live trading
USE_PAPER_TRADING=true

# ========== ALPACA API - PAPER TRADING ==========
# Get keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# ========== ALPACA API - LIVE TRADING ==========
# Get keys from: https://app.alpaca.markets/brokerage/dashboard/overview
# WARNING: Live trading uses real money!
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# ========== AUTHENTICATION ==========
# Password for the web UI login
UI_PASSWORD=

# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# ========== SERVER ==========
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend API URL for frontend to use
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== OPTIONAL: WHATSAPP NOTIFICATIONS ==========
# Enable WhatsApp notifications via WAHA
WHATSAPP_ENABLED=false

# Your phone number (digits only, no + or spaces)
WHATSAPP_PHONE_NUMBER=

# Optional: Send to a WhatsApp group instead (format: 123456789@g.us)
# Use scripts/53-search-waha-groups.py to find group IDs
WHATSAPP_GROUP_ID=

# WAHA API configuration
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION_NAME=default

# ========== OPTIONAL: CLOUDFLARE ==========
# For deploying frontend to Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ========== OPTIONAL: DEBUG ==========
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (more verbose logging)
DEBUG=false
